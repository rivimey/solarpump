	(text "SEL tied HIGH -> use 1.65/max 1.8A charge (otherwise USB)\nPROG1 => current limit. 2K sets 500mA\nPROG2 N/C because SEL is not USB\nPROG3 sets end of charge point.\nCE = charge enable, high to use Bat.\nTHERM regulates Bat temp."
		(exclude_from_sim no)
		(at 259.08 104.394 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left bottom)
		)
		(uuid "09473836-40e3-412c-b433-a27c5847c2d7")
	)
